# =============================================================================
# Myth Rx: Busting Health Hoaxes — Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to '.env' for local development:
#      cp .env.example .env
# 2. Replace the placeholder values below with your actual project credentials
#    from your Supabase Dashboard (Project Settings -> API).
# 3. NEVER commit your real '.env' file or service_role key to GitHub.
# =============================================================================

# Supabase Project URL (Public)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (Public / Client-safe with RLS)
# Safe for client browsers when Row Level Security (RLS) is enabled.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# Local Development Server Port (Optional, defaults to 3000)
PORT=3000
